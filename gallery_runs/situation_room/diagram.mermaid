flowchart TD
    s0(["bbc_world"]):::source
    s1(["npr_news"]):::source
    s2(["al_jazeera"]):::source
    v0["v0: severity_classifier"]:::agent
    v1["v1: geolocator"]:::agent
    v2["v2: briefing_writer"]:::agent
    k0[("intelligence_display")]:::sink
    k1[("jsonl_recorder_briefing")]:::sink

    s0 --> v0
    s1 --> v0
    s2 --> v0
    v0 --> v1
    v1 --> v2
    v2 -->|critical| k0
    v2 -->|critical| k1
    v2 -->|else| k1

    classDef source fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef sink fill:#ede7f6,stroke:#5e35b1,color:#311b92;
    classDef sync fill:#fff3e0,stroke:#ef6c00,color:#e65100;
    classDef router fill:#fce4ec,stroke:#c2185b,color:#880e4f;
    classDef agent fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
